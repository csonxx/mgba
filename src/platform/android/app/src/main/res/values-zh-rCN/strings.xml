    <string name="help_row_pause_reset_name">暂停 / 继续 / 重置 / 单帧</string>
    <string name="help_row_pause_reset_desc">暂停或继续游戏，重启当前游戏，或在暂停时前进一帧。</string>
    <string name="help_row_fast_name">加速 / 按住 / 1x-8x / 模式</string>
    <string name="help_row_fast_desc">同时加速画面和声音。切换模式是点一下开、再点一下关；按住模式只在按住按钮时加速。</string>
    <string name="help_row_rewind_name">倒带 / 倒开 / 倒B / 倒I</string>
    <string name="help_row_rewind_desc">按住倒带可以回退。倒开控制是否记录历史，倒B 调整历史容量，倒I 调整倒带点之间的间隔。</string>
    <string name="help_row_toolbar_state_more_name">状态 / 存档 / 更多</string>
    <string name="help_row_toolbar_state_more_desc">状态显示或隐藏性能信息。存档打开存档和数据操作。更多打开画面、声音、输入、传感器、截图、诊断和帮助。</string>
    <string name="help_row_load_save_name">读取 / 保存 / 存档位</string>
    <string name="help_row_load_save_desc">读取会从带缩略图的列表选择自动存档或编号槽位。保存会写入编号槽位。存档位可以管理所有槽位，包括删除、导出和导入。</string>
    <string name="help_row_auto_name">存自动档 / 读自动档</string>
    <string name="help_row_auto_desc">存自动档会立刻写入自动存档槽。读自动档会立刻读取自动存档槽。</string>
    <string name="help_row_data_name">备份 / 导出包 / 导入包 / 导入</string>
    <string name="help_row_data_desc">备份会导出电池存档。导出包和导入包会导出或导入完整游戏数据包。导入用于导入电池存档文件。</string>
    <string name="help_row_cheat_patch_name">金手指 / 清金手指 / 补丁 / 清补丁</string>
    <string name="help_row_cheat_patch_desc">管理或清除当前游戏的金手指和 ROM 补丁。</string>
    <string name="help_row_exit_name">退出</string>
    <string name="help_row_exit_desc">刷新保存数据并离开游戏界面。</string>
    <string name="help_row_main_actions_name">搜索 / 添加 / 设置 / 继续游戏</string>
    <string name="help_row_main_actions_desc">搜索会聚焦游戏库搜索框。添加可打开单个 ROM 或文件夹。设置显示模拟器设置。继续游戏返回正在运行的会话。</string>
    <string name="help_row_library_name">打开 ROM / 扫描文件夹 / 游戏库文件夹</string>
    <string name="help_row_library_desc">打开 ROM 选择单个文件。扫描文件夹会索引文件夹里的 ROM。游戏库文件夹管理已记住的扫描文件夹。</string>
    <string name="help_row_bios_logs_name">BIOS / 补丁 / 日志 / 存储 / 缓存</string>
    <string name="help_row_bios_logs_desc">导入或清除 BIOS 和补丁文件，导出日志，查看应用存储，或清理临时压缩包和导入缓存。</string>
    <string name="help_row_settings_backup_name">导出设置 / 导入设置</string>
    <string name="help_row_settings_backup_desc">备份或恢复模拟器设置、游戏库记录、最近游戏和单游戏覆盖设置。</string>
    <string name="help_row_auto_values_name">自动存档 / 自动间隔</string>
    <string name="help_row_auto_values_desc">自动存档开启后，游戏启动会读取自动存档，之后每隔自动间隔保存一次，并在暂停或退出时再保存一次。当前间隔：%1$d 秒。默认：%2$d 秒。范围：%3$d-%4$d 秒。</string>
    <string name="help_row_speed_values_name">加速倍率</string>
    <string name="help_row_speed_values_desc">支持值：%1$s。1x 是正常速度，更大的值会同时加速画面和声音。</string>
    <string name="help_row_video_values_name">缩放 / 滤镜 / 帧混合 / 跳帧</string>
    <string name="help_row_video_values_desc">缩放决定画面如何适配屏幕。滤镜控制像素平滑。帧混合可以减轻闪烁。跳帧用流畅度换性能。</string>
    <string name="help_row_audio_values_name">静音 / 声音 / 音量 / 音频缓冲 / 低通</string>
    <string name="help_row_audio_values_desc">静音关闭声音；声音会恢复音频输出。音量调整输出大小。低延迟更跟手，均衡是默认值，稳定更抗卡顿。低通值越高声音越柔和。</string>
    <string name="help_row_input_values_name">虚拟键 / 虚拟键设 / 死区 / 反向开 / 震动 / 体感</string>
    <string name="help_row_input_values_desc">虚拟键显示屏幕按键。虚拟键设调整大小、透明度、间距、震动、左右手和布局。死区调整摇杆阈值。反向开允许同时输入相反方向。震动和体感控制振动与动作输入。</string>
    <string name="help_row_sensor_tools_name">太阳 / 相机 / 按键 / GDB / 诊断 / 截图 / 导出</string>
    <string name="help_row_sensor_tools_desc">太阳控制光照等级。相机导入或拍摄 Game Boy Camera 图片。按键映射硬件按键。GDB 切换调试服务。诊断导出运行信息。截图用于分享截图，导出用于保存截图。</string>
    <string name="help_row_language_values_name">语言 / 日志级别 / RTC</string>
    <string name="help_row_language_values_desc">语言可切换英文、简体中文、繁体中文、日文和俄文。日志级别控制调试详情。RTC 可选择真实时钟、固定时间、伪纪元或墙钟偏移。</string>

