<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/mgba_panel" />
            <stroke android:width="1dp" android:color="@color/mgba_hairline" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mgba_canvas_soft" />
            <stroke android:width="1dp" android:color="@color/mgba_accent" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mgba_background" />
            <stroke android:width="1dp" android:color="@color/mgba_hairline_strong" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</selector>
