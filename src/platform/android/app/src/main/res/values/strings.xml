    <string name="help_row_pause_reset_name">Pause / Resume / Reset / Step</string>
    <string name="help_row_pause_reset_desc">Pause or continue the game, restart the current game, or advance one frame while paused.</string>
    <string name="help_row_fast_name">Fast / Hold / 1x-8x / Mode</string>
    <string name="help_row_fast_desc">Fast-forward video and audio. Toggle mode turns it on or off with a tap; Hold mode only runs fast while the button is pressed.</string>
    <string name="help_row_rewind_name">Rw / RwOn / RwB / RwI</string>
    <string name="help_row_rewind_desc">Hold Rw to rewind. RwOn enables history, RwB changes history capacity, and RwI changes spacing between saved rewind points.</string>
    <string name="help_row_toolbar_state_more_name">Stats / State / More</string>
    <string name="help_row_toolbar_state_more_desc">Stats toggles the performance overlay. State opens save and data actions. More opens video, audio, input, sensors, screenshots, diagnostics, and Help.</string>
    <string name="help_row_load_save_name">Load / Save / States</string>
    <string name="help_row_load_save_desc">Load picks an autosave or numbered slot with thumbnails. Save writes a numbered slot. States manages every slot, including delete, export, and import.</string>
    <string name="help_row_auto_name">AutoSave / AutoLoad</string>
    <string name="help_row_auto_desc">AutoSave writes the autosave slot now. AutoLoad loads the autosave slot now.</string>
    <string name="help_row_data_name">Backup / DataOut / DataIn / Import</string>
    <string name="help_row_data_desc">Backup exports the battery save. DataOut and DataIn export or import the full game data package. Import imports a battery save file.</string>
    <string name="help_row_cheat_patch_name">Cheats / NoCheat / Patch / NoPatch</string>
    <string name="help_row_cheat_patch_desc">Manage or clear cheats and ROM patches for the current game.</string>
    <string name="help_row_exit_name">Exit</string>
    <string name="help_row_exit_desc">Flush save data and leave the game screen.</string>
    <string name="help_row_main_actions_name">Search / Add / Settings / Resume Game</string>
    <string name="help_row_main_actions_desc">Search focuses the library search box. Add opens one ROM or a folder. Settings shows emulator settings. Resume Game returns to a running session.</string>
    <string name="help_row_library_name">Open ROM / Scan Folder / Library Folders</string>
    <string name="help_row_library_desc">Open ROM picks one file. Scan Folder indexes ROMs from a folder. Library Folders manages remembered scan folders.</string>
    <string name="help_row_bios_logs_name">BIOS / Patch / Logs / Storage / Cache</string>
    <string name="help_row_bios_logs_desc">Import or clear BIOS and patch files, export logs, inspect app storage, or clear temporary archive and import cache files.</string>
    <string name="help_row_settings_backup_name">Export Settings / Import Settings</string>
    <string name="help_row_settings_backup_desc">Back up or restore emulator settings, library records, recent games, and per-game overrides.</string>
    <string name="help_row_auto_values_name">Auto State / Auto Interval</string>
    <string name="help_row_auto_values_desc">Auto State On loads autosave at game start, saves every Auto Interval, and saves on pause or exit. Current interval: %1$ds. Default: %2$ds. Range: %3$d-%4$ds.</string>
    <string name="help_row_speed_values_name">Fast Speed</string>
    <string name="help_row_speed_values_desc">Supported values: %1$s. 1x is normal speed; larger values speed up both video and audio.</string>
    <string name="help_row_video_values_name">Scale / Filter / Interframe / Frame Skip</string>
    <string name="help_row_video_values_desc">Scale controls how the video fits the screen. Filter changes pixel smoothing. Interframe blends adjacent frames to reduce flicker. Frame Skip trades smoothness for performance.</string>
    <string name="help_row_audio_values_name">Mute / Sound / Vol / Audio Buffer / Low Pass</string>
    <string name="help_row_audio_values_desc">Mute disables audio; Sound restores it. Volume changes output level. Low Latency has less delay, Balanced is the default, Stable is safer. Low Pass softens audio at higher values.</string>
    <string name="help_row_input_values_name">Pad / PadCfg / DZ / OppOn / Rumble / Tilt</string>
    <string name="help_row_input_values_desc">Pad shows virtual controls. PadCfg adjusts size, opacity, spacing, haptics, handedness, and layout. DZ changes analog deadzone. OppOn allows opposing directions. Rumble and Tilt control vibration and motion input.</string>
    <string name="help_row_sensor_tools_name">Solar / Camera / Keys / GDB / Diag / Shot / Export</string>
    <string name="help_row_sensor_tools_desc">Solar controls light level. Camera imports or captures a Game Boy Camera image. Keys maps hardware buttons. GDB toggles the debug stub. Diag exports diagnostics. Shot shares a screenshot, and Export saves it.</string>
    <string name="help_row_language_values_name">Language / Log Level / RTC</string>
    <string name="help_row_language_values_desc">Language switches English, Simplified Chinese, Traditional Chinese, Japanese, and Russian. Log Level changes debug detail. RTC chooses real clock, fixed time, fake epoch, or wall-clock offset.</string>

